<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:components="clr-namespace:trackr.Components"
    xmlns:views="clr-namespace:trackr.Views"
    x:Class="trackr.Pages.DashboardPage"
    x:DataType="viewModels:DashboardPageViewModel"
    x:Name="RootPage"
    Title="Dashboard"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid>

        <VerticalStackLayout
            x:Name="MainContent"
            Padding="30">

            <!-- Dashboard Header -->
            <Grid
                ColumnDefinitions="*,Auto">

                <!-- Dashboard Title -->
                <Label
                    Grid.Column="0"
                    Style="{StaticResource PageTitle}"
                    Text="Dashboard"/>

                <!-- Add Account Button -->
                <Button
                    Grid.Column="1"
                    x:Name="AddAccountButton"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    Text="+"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
                    Command="{Binding ShowAddAccountFormCommand}"/>

            </Grid>

            <!-- Net Worth -->
            <components:NetWorthCard/>

            <!-- Accounts Header -->
            <Label
                Text="ACCOUNTS"
                FontSize="13"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                Margin="0,10,0,0"/>

            <!-- Accounts List -->
            <CollectionView
                ItemsSource="{Binding BankAccounts}">

                <!-- Account Items -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10"/>

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="viewModels:BankAccountViewModel">

                        <components:AccountCard
                            ShowAccountOptionsCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowAccountOptionsCommand}"
                            LogoTapCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.LogoTapCommand}"
                            ToggleCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleTransactionsCommand}"/>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

        <!-- Loading Overlay -->
        <components:LoadingOverlay
            x:Name="LoadingOverlay"/>

    </Grid>

</ContentPage>