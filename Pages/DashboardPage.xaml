<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr"
    xmlns:models="clr-namespace:trackr.Models"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    x:Class="trackr.Pages.DashboardPage"
    x:DataType="viewModels:DashboardViewModel"
    x:Name="RootPage"
    Title="Dashboard"
    BackgroundColor="#27272a">
    <ContentPage.Resources>
        <local:AmountToColorConverter x:Key="AmountToColorConverter"/>
        <local:BankToImageConverter x:Key="BankToImageConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout
                x:Name="MainComponent"
                Padding="25,0"
                Spacing="15">
                <Grid>
                    <!-- Dashboard Header -->
                    <Label
                        Text="Dashboard"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#f9f7ff"
                        HorizontalOptions="Start"
                        Margin="0,10,0,0"/>
                    <!-- Add Account Button -->
                    <Button
                        x:Name="AddAccountButton"
                        HorizontalOptions="End"
                        BackgroundColor="#a188d8"
                        FontSize="50"
                        Text="+"
                        TextColor="#f9f7ff"
                        Command="{Binding AddAccountCommand}"/>
                </Grid>
                <!-- Accounts Header -->
                <Label
                    Text="Accounts"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#f9f7ff"
                    HorizontalOptions="Start"
                    Margin="0,10,0,0"/>
                <!-- Accounts List -->
                <CollectionView
                    x:Name="AccountsCollectionView"
                    ItemsSource="{Binding BankAccounts}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate
                            x:DataType="models:BankAccount">
                            <Grid Margin="0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border
                                    Padding="20"
                                    Stroke="#52446f"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="#1f1f1f">
                                    <VerticalStackLayout
                                        Spacing="10">
                                        <Grid
                                            ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="25"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="25"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Grid.Column="0">
                                                <!-- Three Dots Menu -->
                                                <Image
                                                    Grid.Column="0"
                                                    Source="three_dots.webp"
                                                    Margin="0,0,5,0"
                                                    BackgroundColor="Transparent"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="Center">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowMenuCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Grid>
                                            <!-- Bank Logo -->
                                            <Image
                                                Grid.Column="1"
                                                Source="{Binding BankInstitution, Converter={StaticResource BankToImageConverter}}"
                                                Margin="0,0,5,0"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.LogoTapCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Image.GestureRecognizers>
                                            </Image>

                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                VerticalOptions="Center">
                                                <!-- Account Name -->
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontAttributes="Bold"
                                                    TextColor="#f9f7ff"
                                                    FontSize="13"/>
                                                <!-- Account Type -->
                                                <Label
                                                    Text="{Binding Type}"
                                                    TextColor="Gray"
                                                    FontSize="11"/>
                                            </VerticalStackLayout>

                                            <!-- Balance Label -->
                                            <Label
                                                Grid.Column="3"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"
                                                Text="{Binding Balance, StringFormat='{}{0:$#,##0.00;-$#,##0.00}'}"
                                                TextColor="{Binding Balance, Converter={StaticResource AmountToColorConverter}}"
                                                FontSize="15"/>

                                            <!-- Transactions Toggle -->
                                            <Image
                                                Grid.Column="4"
                                                Source="arrow_down.png"
                                                Margin="5,0,0,0"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleTransactionsCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>

                                        <!-- Transactions List -->
                                        <CollectionView
                                            ItemsSource="{Binding Transactions}"
                                            IsVisible="{Binding ShowTransactions}"
                                            SelectionMode="None"
                                            MaximumHeightRequest="300">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate
                                                    x:DataType="models:Transaction">
                                                    <Border
                                                        Padding="10"
                                                        Stroke="#52446f"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#1e1e21">
                                                        <Grid
                                                            Padding="5"
                                                            MaximumHeightRequest="150">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Transaction Icon -->
                                                            <Image
                                                                Grid.Column="0"
                                                                Source="{Binding Icon}"
                                                                VerticalOptions="Center"
                                                                HorizontalOptions="Center"/>
                                                            <Grid
                                                                Grid.Column="1">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <!-- Description -->
                                                                <Label
                                                                    Grid.Row="0"
                                                                    Text="{Binding Description}"
                                                                    FontSize="13"
                                                                    FontAttributes="Bold"
                                                                    TextColor="#f9f7ff"/>
                                                                <!-- Date + Category -->
                                                                <Grid
                                                                    Grid.Row="1"
                                                                    ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Label
                                                                        Grid.Row="11"
                                                                        Text="{Binding Date, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                        FontSize="10"
                                                                        TextColor="#a188d8"/>
                                                                    <Label
                                                                        Grid.Row="11"
                                                                        Text="{Binding Category}"
                                                                        FontSize="10"
                                                                        TextColor="#a188d8"/>
                                                                </Grid>
                                                            </Grid>
                                                            <!-- Amount -->
                                                            <Label
                                                                Grid.Column="1"
                                                                FontSize="15"
                                                                FontAttributes="Bold"
                                                                Text="{Binding Amount, StringFormat='{}{0:+$#,##0.00;-$#,##0.00}'}"
                                                                TextColor="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"
                                                                HorizontalOptions="End"
                                                                VerticalOptions="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <!-- <Grid
            x:Name="LoadingOverlay"
            BackgroundColor="#00000088"
            IsVisible="True"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            ZIndex="100">
            <ActivityIndicator IsRunning="True"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Color="White"
                               WidthRequest="100"
                               HeightRequest="100"/>
        </Grid> -->
    </Grid>
</ContentPage>