<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr"
    xmlns:models="clr-namespace:trackr.Models"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:components="clr-namespace:trackr.Components"
    xmlns:controls="clr-namespace:trackr.Controls"
    xmlns:views="clr-namespace:trackr.Views"
    x:Class="trackr.Pages.DashboardPage"
    x:DataType="viewModels:DashboardViewModel"
    x:Name="RootPage"
    Title="Dashboard"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid>

        <Grid
            x:Name="MainContent"
            Padding="25"
            RowSpacing="10">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="150"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- Dashboard Header -->
            <Grid
                Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition
                        Width="*"/>

                    <ColumnDefinition
                        Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- Dashboard Title -->
                <Label
                    Grid.Column="0"
                    Text="Dashboard"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"/>

                <!-- Add Account Button -->
                <Button
                    Grid.Column="1"
                    x:Name="AddAccountButton"
                    WidthRequest="20"
                    HeightRequest="20"
                    CornerRadius="10"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    Text="+"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    Command="{Binding ShowAddAccountFormCommand}"/>

            </Grid>

            <!-- Net Worth -->
            <Border
                Grid.Row="1"
                Padding="20"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryBackgroundLight}, Dark={StaticResource SecondaryBackgroundDark}}">

                <Label
                    Text="NET WORTH"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>

            </Border>

            <!-- Accounts Header -->
            <Label
                Grid.Row="2"
                Text="ACCOUNTS"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                HorizontalOptions="Start"
                Margin="0,10,0,0"/>

            <!-- Accounts List -->
            <CollectionView
                Grid.Row="3"
                x:Name="AccountsCollectionView"
                ItemsSource="{Binding BankAccounts}"
                SelectionMode="None">

                <!-- Account Items -->
                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10"/>

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:BankAccount">

                        <components:AccountCard
                            ShowAccountOptionsCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowAccountOptionsCommand}"
                            LogoTapCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.LogoTapCommand}"
                            ToggleCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleTransactionsCommand}"/>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- Add Account Form -->
        <controls:BottomSheet
            x:Name="AddAccountSheet"
            Title="Add Account">

            <controls:BottomSheet.SheetContent>

                <views:AddAccountView
                    x:Name="AddAccountForm"/>

            </controls:BottomSheet.SheetContent>

        </controls:BottomSheet>

        <!-- Account Options Form -->
        <controls:BottomSheet
            x:Name="AccountOptionsSheet"
            Title="Account Options">

            <controls:BottomSheet.SheetContent>

                <views:AccountOptionsView
                    x:Name="AccountOptionsForm"/>

            </controls:BottomSheet.SheetContent>

        </controls:BottomSheet>

        <!-- Loading Overlay -->
        <components:LoadingOverlay
            x:Name="LoadingOverlay"/>

    </Grid>

</ContentPage>