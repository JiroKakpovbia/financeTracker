<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:components="clr-namespace:trackr.Components"
    xmlns:views="clr-namespace:trackr.Views"
    x:Class="trackr.Pages.SearchPage"
    x:DataType="viewModels:SearchPageViewModel"
    x:Name="RootPage"
    Title="Search">

    <Grid>

        <Grid
            x:Name="MainContent"
            Padding="30"
            RowSpacing="20"
            RowDefinitions="Auto,Auto,*">

            <!-- Search Header -->
            <Label
                Grid.Row="0"
                Style="{StaticResource PageTitle}"
                Text="Search"/>

            <!-- Search Bar -->
            <Entry
                Grid.Row="1"
                Text="{Binding SearchQuery, Mode=TwoWay}"
                Placeholder="Search transactions..."
                ReturnType="Search"/>

            <!-- Search Results -->
            <Grid
                Grid.Row="2"
                RowDefinitions="Auto,*"
                RowSpacing="5">

                <!-- Results Header -->
                <Label
                    Grid.Row="0"
                    Style="{StaticResource SectionHeader}"
                    IsVisible="{Binding HasResults}"
                    Text="{Binding SearchResults, StringFormat='{}{0} RESULTS'}"/>

                <!-- Transactions List -->
                <CollectionView
                    Grid.Row="1"
                    IsVisible="{Binding HasResults}"
                    ItemsSource="{Binding DisplayedTransactions}"
                    SelectionMode="Single"
                    SelectionChanged="OnTransactionSelected"
                    RemainingItemsThreshold="5"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                    <CollectionView.ItemsLayout>

                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="10"/>

                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>

                        <DataTemplate x:DataType="viewModels:TransactionViewModel">

                            <components:TransactionCard
                                ShowMoreInfo="True"/>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

            <!-- No Results -->
            <VerticalStackLayout
                Grid.Row="2"
                IsVisible="{Binding NoResultsFound}"
                VerticalOptions="Center"
                Spacing="10">

                <Image>

                    <Image.Source>

                        <FontImageSource
                            FontFamily="FontAwesomeSolid"
                            Glyph="&#xf002;"
                            Size="30"
                            Color="{AppThemeBinding 
                            Light={StaticResource SecondaryTextLight}, 
                            Dark={StaticResource SecondaryTextDark}}"/>

                    </Image.Source>

                </Image>

                <Label
                    Style="{StaticResource SectionHeader}"
                    Text="No transactions found."
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </Grid>

        <!-- Loading Overlay -->
        <components:LoadingOverlay
            x:Name="LoadingOverlay"/>

    </Grid>
</ContentPage>