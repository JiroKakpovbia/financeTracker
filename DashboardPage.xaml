<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:financeTracker"
             x:Class="financeTracker.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#27272a">
    <ContentPage.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="MainComponent"
                                 Padding="25,0"
                                 Spacing="15">
                <Label Text="My Accounts"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#f9f7ff"
                       HorizontalOptions="Start"
                       Margin="0,10,0,0"/>
                <CollectionView x:Name="AccountsCollectionView"
                                ItemsSource="{Binding BankAccounts}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Stroke="Gray"
                                    BackgroundColor="#1f1f1f">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.15*"/>
                                            <ColumnDefinition Width="0.15*"/>
                                            <ColumnDefinition Width="0.55*"/>
                                            <ColumnDefinition Width="0.15*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <!-- Three Dots Menu -->
                                            <ImageButton
                                                Grid.Column="0"
                                                Margin="0,0,5,0"
                                                IsVisible="{Binding BindingContext.MoveMode, Source={x:Reference AccountsCollectionView}, Converter={StaticResource InverseBoolConverter}}"
                                                Source="three_dots.webp"
                                                BackgroundColor="Transparent"
                                                Command="{Binding BindingContext.ShowMenuCommand, Source={x:Reference AccountsCollectionView}}"
                                                CommandParameter="{Binding Id}"/>

                                            <!-- Move Account Buttons -->
                                            <VerticalStackLayout
                                                Margin="0,0,5,0"
                                                IsVisible="{Binding BindingContext.MoveMode, Source={x:Reference AccountsCollectionView}}">
                                                <ImageButton
                                                    Source="arrow_up.png"
                                                    BackgroundColor="Transparent"
                                                    Command="{Binding BindingContext.MoveUpCommand, Source={x:Reference AccountsCollectionView}}"
                                                    CommandParameter="{Binding Id}"/>
                                                <ImageButton
                                                    Source="arrow_down.png"
                                                    BackgroundColor="Transparent"
                                                    Command="{Binding BindingContext.MoveDownCommand, Source={x:Reference AccountsCollectionView}}"
                                                    CommandParameter="{Binding Id}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <!-- Bank Logo -->
                                        <ImageButton Grid.Column="1"
                                                     Margin="0,0,5,0"
                                                     Source="{Binding BankImage}"
                                                     Command="{Binding BindingContext.LogoTapCommand, Source={x:Reference AccountsCollectionView}}"
                                                     CommandParameter="{Binding Bank}"/>

                                        <!-- Labels -->
                                        <VerticalStackLayout Grid.Column="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   TextColor="#f9f7ff"
                                                   FontSize="20"/>
                                            <Label Text="{Binding Balance, StringFormat='Balance: ${0:F2}'}"
                                                   TextColor="Gray"
                                                   FontSize="18"/>
                                        </VerticalStackLayout>

                                        <!-- Transactions Toggle -->
                                        <ImageButton Grid.Column="3"
                                                     Margin="5,0,0,0"
                                                     IsVisible="{Binding BindingContext.MoveMode, Source={x:Reference AccountsCollectionView}, Converter={StaticResource InverseBoolConverter}}"
                                                     Source="arrow_down.png"
                                                     BackgroundColor="Transparent"
                                                     Command="{Binding BindingContext.ToggleTransactionsCommand, Source={x:Reference AccountsCollectionView}}"
                                                     CommandParameter="{Binding Id}"/>
                                    </Grid>

                                    <!-- Transactions List -->
                                    <CollectionView ItemsSource="{Binding Transactions}"
                                                    IsVisible="{Binding ShowTransactions}"
                                                    SelectionMode="None"
                                                    MaximumHeightRequest="300">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10"
                                                        Stroke="#52446f"
                                                        BackgroundColor="#1e1e21">
                                                    <Grid Padding="5"
                                                          MaximumHeightRequest="150">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Label Grid.Row="0"
                                                                   Text="{Binding Description}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#f9f7ff"/>
                                                            <Label Grid.Row="1"
                                                                   Text="{Binding Date, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                   FontSize="12"
                                                                   TextColor="#a188d8"/>
                                                        </Grid>
                                                        <Label Grid.Column="1"
                                                               FontSize="20"
                                                               FontAttributes="Bold"
                                                               Text="{Binding Amount, StringFormat='${0:F2}'}"
                                                               TextColor="#f9f7ff"
                                                               HorizontalOptions="End"
                                                               VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid>
                    <!-- Add Account Button -->
                    <Button HorizontalOptions="Start"
                            BackgroundColor="#a188d8"
                            FontSize="15"
                            Text="Add Account"
                            TextColor="#f9f7ff"
                            Command="{Binding BindingContext.AddAccountCommand, Source={x:Reference AccountsCollectionView}}"/>
                    <!-- Move Mode Finish Button -->
                    <Button HorizontalOptions="End"
                            BackgroundColor="#a188d8"
                            FontSize="15"
                            Text="Done"
                            TextColor="#f9f7ff"
                            IsVisible="{Binding MoveMode}"
                            Command="{Binding BindingContext.DoneMoveCommand, Source={x:Reference AccountsCollectionView}}"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="#00000088"
              IsVisible="False"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand"
              ZIndex="100">
            <ActivityIndicator IsRunning="True"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Color="White"
                               WidthRequest="50"
                               HeightRequest="50"/>
        </Grid>
    </Grid>
</ContentPage>