<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="financeTracker.DashboardPage"
            Title="Dashboard"
            BackgroundColor="#27272a">
    <ScrollView>
        <VerticalStackLayout
            Padding="25,0"
            Spacing="15">
            <VerticalStackLayout x:Name="BankListLayout" />
            <Button HorizontalOptions="Center"
                    BackgroundColor="#a188d8"
                    FontSize="15"
                    Text="Add Account"
                    TextColor="#f9f7ff"
                    Clicked="OnAddAccountClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>