<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- =========================================================
         BACKGROUNDS / SURFACES
         ========================================================= -->

    <!-- Main application/page background -->
    <Color x:Key="BackgroundLight">#F5F5F7</Color>
    <Color x:Key="BackgroundDark">#27272A</Color>

    <!-- Cards, transaction rows, sheets -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1E21</Color>

    <!-- Slightly elevated / secondary surfaces -->
    <Color x:Key="SecondarySurfaceLight">#F0F0F3</Color>
    <Color x:Key="SecondarySurfaceDark">#18181B</Color>

    <!-- Modal background dim -->
    <Color x:Key="OverlayLight">#70000000</Color>
    <Color x:Key="OverlayDark">#90000000</Color>

    <!-- =========================================================
         TEXT
         ========================================================= -->

    <Color x:Key="PrimaryTextLight">#1E1E21</Color>
    <Color x:Key="PrimaryTextDark">#F9F7FF</Color>

    <Color x:Key="SecondaryTextLight">#707184</Color>
    <Color x:Key="SecondaryTextDark">#A4A1B1</Color>

    <Color x:Key="TertiaryTextLight">#9696A3</Color>
    <Color x:Key="TertiaryTextDark">#777481</Color>

    <Color x:Key="DisabledTextLight">#B8B8C0</Color>
    <Color x:Key="DisabledTextDark">#595861</Color>

    <!-- =========================================================
         ACCENTS
         ========================================================= -->

    <Color x:Key="PrimaryAccentPurpleLight">#7E57C2</Color>
    <Color x:Key="PrimaryAccentPurpleDark">#A188D8</Color>

    <Color x:Key="SecondaryAccentPurpleLight">#B39DDB</Color>
    <Color x:Key="SecondaryAccentPurpleDark">#52446F</Color>

    <Color x:Key="AccentPurpleSurfaceLight">#EEE7FA</Color>
    <Color x:Key="AccentPurpleSurfaceDark">#30283F</Color>

    <!-- =========================================================
         MONEY / STATUS
         ========================================================= -->

    <Color x:Key="PositiveMoney">#4CAF50</Color>
    <Color x:Key="NegativeMoney">#EF3535</Color>
    <Color x:Key="ZeroMoney">#808080</Color>
    <Color x:Key="Warning">#FFC107</Color>

    <!-- =========================================================
         DIVIDERS
         ========================================================= -->

    <Color x:Key="DividerLight">#E7E7EB</Color>
    <Color x:Key="DividerDark">#303035</Color>

    <!-- =========================================================
         DESTRUCTIVE
         ========================================================= -->

    <Color x:Key="DestructiveSurfaceLight">#FCE8E8</Color>
    <Color x:Key="DestructiveSurfaceDark">#3D2426</Color>

    <!-- =========================================================
         CATEGORY SURFACES
         ========================================================= -->

    <!-- Green -->
    <Color x:Key="CategoryGreenSurfaceLight">#E6F3E8</Color>
    <Color x:Key="CategoryGreenSurfaceDark">#203326</Color>

    <!-- Purple -->
    <Color x:Key="CategoryPurpleSurfaceLight">#F2E3F6</Color>
    <Color x:Key="CategoryPurpleSurfaceDark">#35203A</Color>

    <!-- Orange -->
    <Color x:Key="CategoryOrangeSurfaceLight">#FDE9E2</Color>
    <Color x:Key="CategoryOrangeSurfaceDark">#472D28</Color>

    <!-- Yellow -->
    <Color x:Key="CategoryYellowSurfaceLight">#FFF4DD</Color>
    <Color x:Key="CategoryYellowSurfaceDark">#40351E</Color>

    <!-- Pink -->
    <Color x:Key="CategoryPinkSurfaceLight">#FBE4ED</Color>
    <Color x:Key="CategoryPinkSurfaceDark">#40232E</Color>

    <!-- Blue -->
    <Color x:Key="CategoryBlueSurfaceLight">#E5EEF9</Color>
    <Color x:Key="CategoryBlueSurfaceDark">#213248</Color>

    <!-- Cyan -->
    <Color x:Key="CategoryCyanSurfaceLight">#E2F4F5</Color>
    <Color x:Key="CategoryCyanSurfaceDark">#20383A</Color>

    <!-- Teal -->
    <Color x:Key="CategoryTealSurfaceLight">#E1F2EE</Color>
    <Color x:Key="CategoryTealSurfaceDark">#203732</Color>

    <!-- Mint -->
    <Color x:Key="CategoryMintSurfaceLight">#E8F6EF</Color>
    <Color x:Key="CategoryMintSurfaceDark">#21362C</Color>

    <!-- Lime -->
    <Color x:Key="CategoryLimeSurfaceLight">#EFF5DF</Color>
    <Color x:Key="CategoryLimeSurfaceDark">#333A20</Color>

    <!-- Amber -->
    <Color x:Key="CategoryAmberSurfaceLight">#FCEFD8</Color>
    <Color x:Key="CategoryAmberSurfaceDark">#43341E</Color>

    <!-- Red -->
    <Color x:Key="CategoryRedSurfaceLight">#F9E3E3</Color>
    <Color x:Key="CategoryRedSurfaceDark">#422424</Color>

    <!-- Rose -->
    <Color x:Key="CategoryRoseSurfaceLight">#FAE5E8</Color>
    <Color x:Key="CategoryRoseSurfaceDark">#40262C</Color>

    <!-- Magenta -->
    <Color x:Key="CategoryMagentaSurfaceLight">#F7E3F0</Color>
    <Color x:Key="CategoryMagentaSurfaceDark">#3D2436</Color>

    <!-- Indigo -->
    <Color x:Key="CategoryIndigoSurfaceLight">#E8E7F7</Color>
    <Color x:Key="CategoryIndigoSurfaceDark">#292A46</Color>

    <!-- Lavender -->
    <Color x:Key="CategoryLavenderSurfaceLight">#EEE8F8</Color>
    <Color x:Key="CategoryLavenderSurfaceDark">#302944</Color>

    <!-- Sky -->
    <Color x:Key="CategorySkySurfaceLight">#E5F1FA</Color>
    <Color x:Key="CategorySkySurfaceDark">#213647</Color>

    <!-- Brown -->
    <Color x:Key="CategoryBrownSurfaceLight">#F2E9E2</Color>
    <Color x:Key="CategoryBrownSurfaceDark">#392C26</Color>

    <!-- Grey -->
    <Color x:Key="CategoryGreySurfaceLight">#EFEFEF</Color>
    <Color x:Key="CategoryGreySurfaceDark">#2C2C2C</Color>

    <!-- =========================================================
         GRAYS / COMPATIBILITY
         ========================================================= -->

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray700">#2D2D2D</Color>
    <Color x:Key="Gray800">#1F1F1F</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Existing MAUI compatibility keys -->
    <Color x:Key="Primary">#7E57C2</Color>
    <Color x:Key="PrimaryDark">#A188D8</Color>
    <Color x:Key="PrimaryDarkText">#F9F7FF</Color>
    <Color x:Key="SecondaryDarkText">#F9F7FF</Color>
    <Color x:Key="Secondary">#B39DDB</Color>
    <Color x:Key="Tertiary">#52446F</Color>
    <Color x:Key="OffBlack">#27272A</Color>
    <Color x:Key="MidnightBlue">#1E1E21</Color>
    <Color x:Key="Magenta">#7E57C2</Color>

</ResourceDictionary>