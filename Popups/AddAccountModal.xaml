<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="trackr.Popups.AddAccountModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    IsVisible="False"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <Grid>
        <!-- Dark background -->
        <BoxView
            BackgroundColor="#80000000"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="False"/>

        <!-- Bottom sheet -->
        <Border
            x:Name="ModalSheet"
            BackgroundColor="#1e1e21"
            VerticalOptions="End"
            HorizontalOptions="Fill"
            StrokeThickness="0"
            Padding="24"
            Margin="0,0,0,-35">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="50"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="16">

                <!-- Drag handle -->
                <BoxView
                    HeightRequest="5"
                    WidthRequest="40"
                    HorizontalOptions="Center"
                    BackgroundColor="#777"
                    CornerRadius="5"/>

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Add Account"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#f9f7ff"/>
                    <Button
                        Grid.Column="1"
                        Text="✕"
                        WidthRequest="30"
                        HeightRequest="30"
                        CornerRadius="15"
                        BackgroundColor="#333337"
                        TextColor="#f9f7ff"
                        Clicked="CancelClicked"/>
                </Grid>

                <!-- Name -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="ACCOUNT NAME"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#999"/>
                    <Entry
                        x:Name="NameEntry"
                        Placeholder="e.g. Main Chequing"
                        PlaceholderColor="#888"
                        TextColor="#f9f7ff"
                        BackgroundColor="#2a2a2e"/>
                </VerticalStackLayout>

                <!-- Bank -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="BANK"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#999"/>
                    <Picker
                        x:Name="BankPicker"
                        Title="Select Bank"
                        TextColor="#f9f7ff"
                        BackgroundColor="#2a2a2e"
                        ItemDisplayBinding="{Binding .}"/>
                </VerticalStackLayout>

                <!-- Type -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="ACCOUNT TYPE"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#999"/>
                    <Picker
                        x:Name="TypePicker"
                        Title="Select Account Type"
                        TextColor="#f9f7ff"
                        BackgroundColor="#2a2a2e"
                        ItemDisplayBinding="{Binding .}"/>
                </VerticalStackLayout>

                <!-- Balance -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="CURRENT BALANCE"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#999"/>
                    <Entry
                        x:Name="BalanceEntry"
                        Placeholder="0.00"
                        Keyboard="Numeric"
                        TextColor="#f9f7ff"
                        PlaceholderColor="#888"
                        BackgroundColor="#2a2a2e"/>
                </VerticalStackLayout>

                <!-- Add Account Button -->
                <Grid Padding="30,10,30,10">
                    <Button
                        Text="Add Account"
                        HorizontalOptions="Fill"
                        BackgroundColor="#a188d8"
                        TextColor="White"
                        Clicked="HandleAddAccountConfirmation"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>  