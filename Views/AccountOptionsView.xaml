<?xml version="1.0" encoding="utf-8" ?>

<toolkit:Popup
    x:Class="trackr.Views.AccountOptionsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Padding="0"
    BackgroundColor="Transparent">

    <Border
        x:Name="PopupBorder">

        <VerticalStackLayout
            Spacing="20">

            <!-- Account Options Header -->
            <Label
                Text="{Binding SelectedAccount.Name, StringFormat='Account Options: {0}'}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>

            <!-- Rename Account -->
            <Button
                Style="{StaticResource PrimaryButton}"
                Text="Rename Account"
                Command="{Binding RenameAccountCommand}"/>

            <!-- Import CSV -->
            <Button
                Style="{StaticResource PrimaryButton}"
                Text="Import CSV"
                Command="{Binding ImportCSVCommand}"/>

            <!-- Move Account -->
            <Button
                Style="{StaticResource PrimaryButton}"
                Text="Move Account"
                Command="{Binding MoveAccountCommand}"/>

            <!-- Delete Account -->
            <Button
                Style="{StaticResource PrimaryButton}"
                Text="Delete Account"
                Command="{Binding DeleteAccountCommand}"/>

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>