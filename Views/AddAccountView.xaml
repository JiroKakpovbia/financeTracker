<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="trackr.Views.AddAccountView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr"
    Title="Add Account">

    <ContentPage.Resources>

        <local:EnumDisplayNameConverter
            x:Key="EnumDisplayNameConverter"/>

    </ContentPage.Resources>

    <VerticalStackLayout
        Padding="30">

        <!-- Add Account Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto">

            <!-- Add Account Title -->
            <Label
                Grid.Column="0"
                Text="Add Account"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Start"/>

            <!-- Cancel Button -->
            <ImageButton
                Grid.Column="1"
                BackgroundColor="Transparent"
                HorizontalOptions="End"
                Command="{Binding CloseCommand}">

                <ImageButton.Source>

                    <FontImageSource
                        FontFamily="FontAwesomeSolid"
                        Glyph="&#xf057;"
                        Size="40"
                        Color="{StaticResource Gray500}"/>

                </ImageButton.Source>

            </ImageButton>

        </Grid>

        <ScrollView>
            <VerticalStackLayout
                Spacing="20">

                <!-- Name -->
                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="ACCOUNT NAME *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray400}"
                        HorizontalTextAlignment="Start"/>

                    <Entry
                        x:Name="NameEntry"
                        Text="{Binding AccountName}"
                        Placeholder="e.g. Main Chequing"/>

                </VerticalStackLayout>

                <!-- Bank -->
                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="BANK INSTITUTION *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray400}"
                        HorizontalTextAlignment="Start"/>

                    <Picker
                        x:Name="BankPicker"
                        IsEnabled="{Binding ArePickersEnabled}"
                        ItemsSource="{Binding BankInstitutions}"
                        ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter},ConverterParameter=Long}"
                        SelectedItem="{Binding SelectedInstitution}"
                        Title="Select Bank Institution"/>

                </VerticalStackLayout>

                <!-- Type -->
                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="ACCOUNT TYPE *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray500}"
                        HorizontalTextAlignment="Start"/>

                    <Picker
                        x:Name="TypePicker"
                        IsEnabled="{Binding ArePickersEnabled}"
                        ItemsSource="{Binding AccountTypes}"
                        ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}"
                        SelectedItem="{Binding SelectedType}"
                        Title="Select Account Type"/>

                </VerticalStackLayout>

                <!-- Account Balance -->
                <VerticalStackLayout
                    Spacing="5">

                    <Label
                        Text="ACCOUNT BALANCE"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray400}"
                        HorizontalTextAlignment="Start"/>

                    <Entry
                        x:Name="BalanceEntry"
                        Text="{Binding CurrentBalance}"
                        Keyboard="Numeric"
                        Placeholder="0.00"/>

                </VerticalStackLayout>

                <!-- CSV Import Confirmation -->
                <Border
                    IsVisible="{Binding HasPendingImport}"
                    BackgroundColor="{StaticResource PositiveMoney}">

                    <VerticalStackLayout>

                        <VerticalStackLayout
                            Spacing="0">

                            <!-- Confirmation -->
                            <Label
                                Text="CSV Imported"
                                FontSize="15"/>

                            <!-- File Name -->
                            <Label
                                Text="{Binding PendingImport.FileName}"
                                FontSize="13"
                                TextColor="{StaticResource Gray400}"/>

                        </VerticalStackLayout>

                        <!-- Transactions Summary -->
                        <Grid
                            ColumnDefinitions="*,*,*">

                            <!-- Transactions -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="0">

                                <Label
                                    Text="{Binding PendingImport.PendingBatch.ImportedCount}"
                                    FontSize="30"/>

                                <Label
                                    Text="TRANSACTIONS"
                                    FontSize="13"/>

                            </VerticalStackLayout>

                            <!-- Possible Duplicates -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding PendingImport.PendingBatch.PossibleDuplicateCount}"
                                    FontSize="30"
                                    TextColor="Yellow"/>

                                <Label
                                    Text="DUPLICATES"
                                    FontSize="13"/>

                            </VerticalStackLayout>

                            <!-- Skipped -->
                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="0">

                                <Label
                                    Grid.Column="3"
                                    Text="{Binding PendingImport.PendingBatch.ErrorCount}"
                                    FontSize="30"
                                    TextColor="{StaticResource NegativeMoney}"/>

                                <Label
                                    Text="SKIPPED"
                                    FontSize="13"/>

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- Buttons -->
                <Grid
                    ColumnDefinitions="*, *"
                    HorizontalOptions="Fill">

                    <!-- Import CSV Button -->
                    <Grid
                        Grid.Column="0"
                        IsVisible="{Binding ShowImportCSVButton}">

                        <Button
                            Text="Import CSV"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryAccentPurpleLight}, Dark={StaticResource SecondaryAccentPurpleDark}}"
                            Command="{Binding ImportCSVCommand}"/>
                    </Grid>

                    <!-- Cancel CSV Import Button -->
                    <Grid
                        Grid.Column="0"
                        IsVisible="{Binding HasPendingImport}">

                        <Button
                            Text="Cancel CSV Import"
                            BackgroundColor="{StaticResource NegativeMoney}"
                            Command="{Binding ClearPendingImportCommand}"/>
                    </Grid>

                    <!-- Add Account Button -->
                    <Grid
                        Grid.Column="1">

                        <Button
                            Text="Add Account"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
                            Command="{Binding AddAccountCommand}"/>

                    </Grid>

                </Grid>

            </VerticalStackLayout>

        </ScrollView>

    </VerticalStackLayout>

</ContentPage>  