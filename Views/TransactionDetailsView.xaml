<?xml version="1.0" encoding="utf-8" ?>

<toolkit:Popup
    x:Class="trackr.Views.TransactionDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr"
    xmlns:components="clr-namespace:trackr.Components"
    Padding="0"
    BackgroundColor="Transparent">

    <ContentView.Resources>

        <local:AmountToColorConverter x:Key="AmountToColorConverter"/>

        <local:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>

    </ContentView.Resources>

    <Border
        x:Name="PopupBorder">

        <VerticalStackLayout
            Spacing="10">

            <!-- Category Icon -->
            <Image>

                <Image.Source>

                    <FontImageSource
                        Glyph="{Binding SelectedTransaction.SubCategory.Category.Icon}"
                        Size="50"
                        Color="{Binding SelectedTransaction.SubCategory.Category.Colour}"/>

                </Image.Source>

            </Image>

            <!-- Transaction Amount -->
            <Label
                Style="{StaticResource PageTitle}"
                Text="{Binding SelectedTransaction.Amount, StringFormat='{}{0:+$#,##0.00;-$#,##0.00}'}"
                TextColor="{Binding SelectedTransaction.Amount, Converter={StaticResource AmountToColorConverter}}"
                HorizontalTextAlignment="Center"/>

            <!-- Transaction Description -->
            <Label
                Style="{StaticResource CardTitle}"
                Text="{Binding SelectedTransaction.Description}"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                HorizontalTextAlignment="Center"
                MaxLines="3"/>

            <!-- Transaction Date -->
            <Label
                Style="{StaticResource DetailLabel}"
                Text="{Binding SelectedTransaction.Date, StringFormat='{0:MMMM d, yyyy}'}"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                HorizontalTextAlignment="Center"/>

            <!-- Transaction Details -->
            <VerticalStackLayout
                Spacing="10">

                <!-- Category -->
                <Grid
                    ColumnDefinitions="Auto, *"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource DetailLabel}"
                        Text="Category"/>

                    <Label
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}"
                        Text="{Binding SelectedTransaction.SubCategory.Name}"/>

                </Grid>

                <!-- Account -->
                <Grid
                    ColumnDefinitions="Auto, *"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource DetailLabel}"
                        Text="Account"/>

                    <Label
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}"
                        Text="{Binding SelectedTransaction.AccountName}"/>

                </Grid>

                <!-- Bank -->
                <Grid
                    ColumnDefinitions="Auto, *"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource DetailLabel}"
                        Text="Bank"/>

                    <Label
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}"
                        Text="{Binding SelectedTransaction.AccountInstitution, Converter={StaticResource EnumDisplayNameConverter}, ConverterParameter=Long}"/>

                </Grid>

                <!-- Imported At -->
                <Grid
                    ColumnDefinitions="Auto, *"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Style="{StaticResource DetailLabel}"
                        Text="Imported At"/>

                    <Label
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}"
                        Text="{Binding SelectedTransaction.ImportedAt, StringFormat='{0:MMMM d, yyyy} at {0:h:mm tt}'}"/>

                </Grid>

            </VerticalStackLayout>

            <!-- Buttons -->
            <components:ButtonGroup
                PrimaryButtonCommand="{Binding EditCategoryCommand}"
                SecondaryButtonCommand="{Binding CloseCommand}"
                PrimaryButtonText="Edit Category"
                SecondaryButtonText="Close"
                IsSecondaryButtonDestructive="true"/>

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>