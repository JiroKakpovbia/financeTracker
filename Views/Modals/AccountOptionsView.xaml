<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="trackr.Views.AccountOptionsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Account Options -->
    <VerticalStackLayout Spacing="10">

        <!-- Rename Account -->
        <Button
            Text="Rename Account"
            HorizontalOptions="Fill"
            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
            Clicked="HandleRenameAccountConfirmation"/>

        <!-- Import CSV -->
        <Button
            Text="Import CSV"
            HorizontalOptions="Fill"
            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
            Clicked="HandleImportCSVConfirmation"/>

        <!-- Move Account -->
        <Button
            Text="Move Account"
            HorizontalOptions="Fill"
            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
            Clicked="HandleMoveAccountConfirmation"/>

        <!-- Delete Account -->
        <Button
            Text="Delete Account"
            HorizontalOptions="Fill"
            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
            Clicked="HandleDeleteAccountConfirmation"/>

    </VerticalStackLayout>

</ContentView>