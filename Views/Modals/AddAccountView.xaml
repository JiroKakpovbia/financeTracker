<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="trackr.Views.AddAccountView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        Spacing="10">

        <!-- Name -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="ACCOUNT NAME"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray400}"/>

            <Entry
                x:Name="NameEntry"
                Placeholder="e.g. Main Chequing"
                PlaceholderColor="{StaticResource Gray400}"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                BackgroundColor="{StaticResource Gray800}"/>

        </VerticalStackLayout>

        <!-- Bank -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="BANK"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray400}"/>

            <Picker
                x:Name="BankPicker"
                Title="Select Bank"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                BackgroundColor="{StaticResource Gray800}"
                ItemDisplayBinding="{Binding .}"/>

        </VerticalStackLayout>

        <!-- Type -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="ACCOUNT TYPE"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray500}"/>

            <Picker
                x:Name="TypePicker"
                Title="Select Account Type"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                BackgroundColor="{StaticResource Gray800}"
                ItemDisplayBinding="{Binding .}"/>

        </VerticalStackLayout>

        <!-- Balance -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="CURRENT BALANCE"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray400}"/>

            <Entry
                x:Name="BalanceEntry"
                Placeholder="0.00"
                Keyboard="Numeric"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                PlaceholderColor="{StaticResource Gray400}"
                BackgroundColor="{StaticResource Gray800}"/>

        </VerticalStackLayout>

        <!-- Add Account Button -->
        <Grid
            Padding="30,10,30,10">

            <Button
                Text="Add Account"
                HorizontalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                Clicked="HandleAddAccountConfirmation"/>

        </Grid>

    </VerticalStackLayout>

</ContentView>  