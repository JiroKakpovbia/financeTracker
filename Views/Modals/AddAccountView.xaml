<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="trackr.Views.AddAccountView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr">

    <ContentView.Resources>

        <local:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>

    </ContentView.Resources>

    <VerticalStackLayout
        Spacing="20">

        <!-- Name -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="ACCOUNT NAME *"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray400}"/>

            <Entry
                x:Name="NameEntry"
                Text="{Binding AccountName}"
                Placeholder="e.g. Main Chequing"/>

        </VerticalStackLayout>

        <!-- Bank -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="BANK INSTITUTION *"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray400}"/>

            <Picker
                x:Name="BankPicker"
                IsEnabled="{Binding ArePickersEnabled}"
                ItemsSource="{Binding BankInstitutions}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}"
                SelectedItem="{Binding SelectedInstitution}"
                Title="Select Bank Institution"/>

        </VerticalStackLayout>

        <!-- Type -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="ACCOUNT TYPE *"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray500}"/>

            <Picker
                x:Name="TypePicker"
                IsEnabled="{Binding ArePickersEnabled}"
                ItemsSource="{Binding AccountTypes}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}"
                SelectedItem="{Binding SelectedType}"
                Title="Select Account Type"/>

        </VerticalStackLayout>

        <!-- Account Balance -->
        <VerticalStackLayout
            Spacing="5">

            <Label
                Text="ACCOUNT BALANCE"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray400}"/>

            <Entry
                x:Name="BalanceEntry"
                Text="{Binding CurrentBalance}"
                Keyboard="Numeric"
                Placeholder="0.00"/>

        </VerticalStackLayout>

        <!-- CSV Import Confirmation -->
        <Border IsVisible="{Binding HasPendingImport}"
                BackgroundColor="{StaticResource PositiveMoney}"
                StrokeShape="RoundRectangle 10">

            <VerticalStackLayout
                Spacing="10"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <!-- Confirmation -->
                <Label
                    Text="CSV Imported"
                    FontSize="15"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>

                <!-- File Name -->
                <Label
                    Text="{Binding PendingImport.FileName}"
                    FontSize="13"
                    TextColor="{StaticResource Gray400}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>

                <!-- Transactions Summary -->
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="10"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">

                    <!-- Transactions -->
                    <VerticalStackLayout
                        Grid.Column="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                        <Label
                            Text="{Binding PendingImport.Transactions.Count}"
                            FontSize="30"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="TRANSACTIONS"
                            FontSize="13"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                    <!-- Possible Duplicates -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                        <Label
                            Grid.Column="2"
                            Text="{Binding PendingImport.PossibleDuplicateCount}"
                            FontSize="30"
                            TextColor="Yellow"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="DUPLICATES"
                            FontSize="13"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                    <!-- Skipped -->
                    <VerticalStackLayout
                        Grid.Column="2"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                        <Label
                            Grid.Column="3"
                            Text="{Binding PendingImport.ErrorCount}"
                            FontSize="30"
                            TextColor="{StaticResource NegativeMoney}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="SKIPPED"
                            FontSize="13"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </Grid>

            </VerticalStackLayout>

        </Border>

        <Grid
            ColumnDefinitions="*, *"
            ColumnSpacing="20"
            HorizontalOptions="Fill">

            <!-- Import CSV Button -->
            <Grid
                Grid.Column="0"
                IsVisible="{Binding ShowImportCSVButton}"
                HorizontalOptions="Fill"
                VerticalOptions="Center">

                <Button
                    Text="Import CSV"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryAccentPurpleLight}, Dark={StaticResource SecondaryAccentPurpleDark}}"
                    Command="{Binding ImportCSVCommand}"/>
            </Grid>

            <!-- Cancel CSV Import Button -->
            <Grid
                Grid.Column="0"
                IsVisible="{Binding HasPendingImport}"
                HorizontalOptions="Fill"
                VerticalOptions="Center">

                <Button
                    Text="Cancel CSV Import"
                    BackgroundColor="{StaticResource NegativeMoney}"
                    Command="{Binding ClearPendingImportCommand}"/>
            </Grid>

            <!-- Add Account Button -->
            <Grid
                Grid.Column="1"
                HorizontalOptions="Fill"
                VerticalOptions="Center">

                <Button
                    Text="Add Account"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
                    Command="{Binding AddAccountCommand}"/>

            </Grid>

        </Grid>

    </VerticalStackLayout>

</ContentView>  