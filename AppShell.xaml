<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="trackr.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:trackr"
    Shell.FlyoutBehavior="Flyout"
    Title="trackr"
    TitleColor="{AppThemeBinding
        Light={StaticResource PrimaryTextLight},
        Dark={StaticResource PrimaryTextDark}}"
    BackgroundColor="{AppThemeBinding
        Light={StaticResource BackgroundLight},
        Dark={StaticResource BackgroundDark}}">

    <ShellContent Title="Dashboard"
                  ContentTemplate="{DataTemplate local:Pages.DashboardPage}"/>

</Shell>
