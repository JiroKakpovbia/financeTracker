<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:local="clr-namespace:trackr"
    x:Class="trackr.Components.CategoryCard"
    x:DataType="viewModels:CategoryViewModel">

    <!-- Category Card -->
    <Border
        BackgroundColor="{Binding Colour}">

        <VerticalStackLayout
            Spacing="10">

            <!-- Category Icon -->
            <Image>

                <Image.Source>

                    <FontImageSource
                        Glyph="{Binding Icon}"
                        Size="30"
                        Color="{AppThemeBinding 
                        Light={StaticResource SecondaryTextLight}, 
                        Dark={StaticResource SecondaryTextDark}}"/>

                </Image.Source>

            </Image>

            <!-- Category Name -->
            <Label
                Style="{StaticResource SectionHeader}"
                Text="{Binding Name}"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

    </Border>

</ContentView>