<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:local="clr-namespace:trackr"
    x:Class="trackr.Components.TransactionCard"
    x:DataType="viewModels:TransactionViewModel"
    x:Name="Root">

    <ContentView.Resources>

        <local:AmountToColorConverter x:Key="AmountToColorConverter"/>

        <local:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>

    </ContentView.Resources>

    <!-- Transaction Card -->
    <Border
        Padding="{Binding CardPadding, Source={x:Reference Root}}">

        <Grid
            ColumnDefinitions="Auto,*,Auto">

            <!-- Category Icon -->
            <Image
                Grid.Column="0"
                VerticalOptions="Center"
                HorizontalOptions="Start">

                <Image.Source>

                    <FontImageSource
                        FontFamily="FontAwesomeSolid"
                        Glyph="{Binding SubCategory.Category.Icon}"
                        Size="30"
                        Color="{Binding SubCategory.Category.Colour}"/>

                </Image.Source>

            </Image>

            <!-- Transaction Details -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0">

                <!-- Description -->
                <Label
                    Text="{Binding Description}"
                    FontSize="15"
                    FontAttributes="Bold"/>

                <!-- More Info -->
                <HorizontalStackLayout
                    Spacing="5">

                    <!-- Date and Account Institution -->
                    <HorizontalStackLayout
                        IsVisible="{Binding ShowMoreInfo, Source={x:Reference Root}}"
                        Spacing="5">

                        <!-- Date -->
                        <Label
                            Text="{Binding Date, StringFormat='{}{0:MMM d, yyyy}'}"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>

                        <!-- Separator -->
                        <Image
                            VerticalOptions="Center">

                            <Image.Source>

                                <FontImageSource
                                    FontFamily="FontAwesomeSolid"
                                    Glyph="&#xf111;"
                                    Size="3"
                                    Color="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>

                            </Image.Source>

                        </Image>

                        <!-- Account Institution -->
                        <Label
                            Text="{Binding AccountInstitution, Converter={StaticResource EnumDisplayNameConverter},ConverterParameter=Short}"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>

                        <!-- Separator -->
                        <Image
                            VerticalOptions="Center">

                            <Image.Source>

                                <FontImageSource
                                    FontFamily="FontAwesomeSolid"
                                    Glyph="&#xf111;"
                                    Size="3"
                                    Color="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>

                            </Image.Source>

                        </Image>

                    </HorizontalStackLayout>

                    <!-- Category -->
                    <Label
                        Text="{Binding SubCategory.Category.Name, TargetNullValue='Uncategorized', FallbackValue='Uncategorized'}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- Amount -->
            <Label
                Grid.Column="2"
                Text="{Binding Amount, StringFormat='{}{0:+$#,##0.00;-$#,##0.00}'}"
                FontSize="15"
                FontAttributes="Bold"
                HorizontalOptions="End"
                VerticalOptions="Center"
                TextColor="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"/>

        </Grid>

    </Border>

</ContentView>