<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:local="clr-namespace:trackr"
    x:Class="trackr.Components.TransactionCard"
    x:DataType="viewModels:TransactionViewModel">

    <ContentView.Resources>

        <local:AmountToColorConverter x:Key="AmountToColorConverter"/>

        <local:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>

    </ContentView.Resources>

    <!-- Transaction Item -->
    <Border>

        <Grid
            ColumnDefinitions="Auto,*,Auto">

            <!-- Transaction Icon -->
            <Image
                Grid.Column="0"
                Source="{Binding SubCategory.Category.Icon, TargetNullValue='uncategorized.png', FallbackValue ='uncategorized.png'}"
                WidthRequest="30"
                HeightRequest="30"
                Aspect="AspectFit"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>

            <!-- Transaction Details -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0">

                <!-- Description -->
                <Label
                    Text="{Binding Description}"
                    FontSize="15"
                    FontAttributes="Bold"/>

                <Grid
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="5">

                    <!-- Account Institution -->
                    <Label
                        Grid.Column="0"
                        Text="{Binding AccountInstitution, Converter={StaticResource EnumDisplayNameConverter}}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>

                    <!-- Separator -->
                    <Label
                        Grid.Column="1"
                        Text=":"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>

                    <!-- Category -->
                    <Label
                        Grid.Column="2"
                        Text="{Binding SubCategory.Category.Name, TargetNullValue='Uncategorized', FallbackValue='Uncategorized'}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"/>
                </Grid>

            </VerticalStackLayout>

            <!-- Amount -->
            <Label
                Grid.Column="2"
                Text="{Binding Amount, StringFormat='{}{0:+$#,##0.00;-$#,##0.00}'}"
                FontSize="15"
                FontAttributes="Bold"
                HorizontalOptions="End"
                VerticalOptions="Center"
                TextColor="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"/>

        </Grid>

    </Border>

</ContentView>