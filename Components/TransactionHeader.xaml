<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:trackr.Models"
    xmlns:local="clr-namespace:trackr"
    x:Class="trackr.Components.TransactionHeader"
    x:DataType="models:TransactionGroup">

    <!-- Transaction Header -->
    <Label
        Text="{Binding Header}"
        FontAttributes="Bold"
        FontSize="13"
        TextColor="#a188d8"/>
        
</ContentView>