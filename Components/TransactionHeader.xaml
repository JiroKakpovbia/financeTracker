<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:local="clr-namespace:trackr"
    x:Class="trackr.Components.TransactionHeader"
    x:DataType="viewModels:TransactionGroupViewModel">

    <!-- Transaction Header -->
    <Grid
        Padding="15,0"
        RowDefinitions="1,Auto,1">

        <BoxView
            Grid.Row="0"
            Color="{StaticResource Gray600}"/>

        <Label
            Grid.Row="1"
            Text="{Binding Header}"
            FontAttributes="Bold"
            FontSize="15"
            TextColor="{AppThemeBinding Light={StaticResource PrimaryAccentPurpleLight}, Dark={StaticResource PrimaryAccentPurpleDark}}"
            VerticalOptions="Center"
            HorizontalOptions="Start"/>

        <BoxView
            Grid.Row="2"
            Color="{StaticResource Gray600}"/>

    </Grid>

</ContentView>