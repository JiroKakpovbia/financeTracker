<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:trackr.ViewModels"
    xmlns:local="clr-namespace:trackr"
    x:Class="trackr.Components.NetWorthCard"
    x:DataType="viewModels:DashboardViewModel">

    <ContentView.Resources>

        <local:AmountToColorConverter x:Key="AmountToColorConverter"/>

    </ContentView.Resources>

    <!-- Net Worth Card -->
    <Border>

        <VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="0">

                <Label
                    Text="NET WORTH"
                    TextColor="Gray"
                    FontSize="13"
                    FontAttributes="Bold"/>

                <Label
                    Text="{Binding NetWorth, StringFormat='{}{0:$#,##0.00;-$#,##0.00}'}"
                    FontSize="30"
                    FontAttributes="Bold"/>

            </VerticalStackLayout>

            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="15">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="0">

                    <Label
                        Text="ASSETS"
                        TextColor="Gray"
                        FontSize="13"
                        FontAttributes="Bold"/>

                    <Label
                        Text="{Binding Assets, StringFormat='{}{0:$#,##0.00;-$#,##0.00}'}"
                        FontSize="15"
                        FontAttributes="Bold"/>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="0">

                    <Label
                        Text="LIABILITIES"
                        TextColor="Gray"
                        FontSize="13"
                        FontAttributes="Bold"/>

                    <Label
                        Text="{Binding Liabilities, StringFormat='{}{0:$#,##0.00;-$#,##0.00}'}"
                        FontSize="15"
                        FontAttributes="Bold"/>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="2"
                    Spacing="0">

                    <Label
                        Text="ACCOUNTS"
                        TextColor="Gray"
                        FontSize="13"
                        FontAttributes="Bold"/>

                    <Label
                        Text="{Binding BankAccounts.Count, StringFormat='{}{0}'}"
                        FontSize="15"
                        FontAttributes="Bold"/>

                </VerticalStackLayout>

            </Grid>

        </VerticalStackLayout>

    </Border>

</ContentView>